# local or persistent
PAPYRUS_MODE=local
PAPYRUS_PROFILE=commercial
PAPYRUS_HOST=127.0.0.1
PAPYRUS_PORT=3210
PAPYRUS_PUBLIC_ORIGIN=http://127.0.0.1:3210
PAPYRUS_DATA_DIR=.papyrus

# Generate both with a password manager. Persistent mode requires a 32+ character session secret.
PAPYRUS_BOOTSTRAP_SECRET=replace-with-single-use-bootstrap-secret
PAPYRUS_SESSION_SECRET=replace-with-at-least-32-random-characters

# Maximum milliseconds for a single prompt turn before the runtime is aborted.
# PAPYRUS_PROMPT_TIMEOUT_MS=600000

# Commercial OIDC
PAPYRUS_OIDC_ISSUER=https://identity.example.gov
PAPYRUS_OIDC_CLIENT_ID=papyrus
PAPYRUS_OIDC_CLIENT_SECRET=
PAPYRUS_OIDC_REDIRECT_URI=http://127.0.0.1:3210/api/auth/oidc/callback

# Government direct CAC/mTLS
PAPYRUS_TLS_CERT=/etc/papyrus/server.pem
PAPYRUS_TLS_KEY=/etc/papyrus/server-key.pem
PAPYRUS_TLS_CA=/etc/papyrus/cac-trust-bundle.pem
PAPYRUS_TLS_CRL=/etc/papyrus/cac-revocation-list.pem

# Offline license trust roots: JSON object mapping key IDs to PEM public keys.
PAPYRUS_LICENSE_REQUIRED=false
PAPYRUS_LICENSE_AUTHORITIES_JSON={}

# Development only. The server refuses this setting on a non-loopback listener.
# PAPYRUS_DEV_IDENTITY=developer:Local Developer

# Model secrets are resolved server-side from the runtime's secretRef.
# secretRef model_primary becomes PAPYRUS_SECRET_MODEL_PRIMARY.
PAPYRUS_SECRET_MODEL_PRIMARY=

# Remote goose workers (runtime mode=remote). The server connects to a supervised
# worker over ACP Streamable HTTP; model credentials travel over this authenticated
# channel and are never logged or returned to the browser.
# PAPYRUS_RUNTIME_WORKER_TOKEN=replace-with-shared-worker-token
# PAPYRUS_RUNTIME_MTLS_CERT=/etc/papyrus/worker-client.pem
# PAPYRUS_RUNTIME_MTLS_KEY=/etc/papyrus/worker-client-key.pem
# PAPYRUS_RUNTIME_MTLS_CA=/etc/papyrus/worker-ca-trust-bundle.pem

# Supervised goose worker (apps/worker). TLS enables mutual TLS (requestCert +
# rejectUnauthorized); without TLS the worker binds loopback only.
# PAPYRUS_WORKER_HOST=127.0.0.1
# PAPYRUS_WORKER_PORT=3211
# PAPYRUS_WORKER_TLS_CERT=/etc/papyrus/worker.pem
# PAPYRUS_WORKER_TLS_KEY=/etc/papyrus/worker-key.pem
# PAPYRUS_WORKER_TLS_CA=/etc/papyrus/worker-client-ca-bundle.pem
# PAPYRUS_WORKER_TOKEN=replace-with-shared-worker-token
# Comma-separated SHA-256 client certificate fingerprints allowed to connect.
# PAPYRUS_WORKER_ALLOW_FINGERPRINTS=ab12cd34...,ef56ab78...
# PAPYRUS_WORKER_GOOSE_COMMAND=goose
# PAPYRUS_WORKER_GOOSE_ARGS=acp

# ACP gateway (model B): arbitrary ACP clients (Zed, VS Code, custom) connect to
# /acp/<runtimeId>. Identity is mutual TLS; a dev token is supported on loopback only.
# PAPYRUS_GATEWAY_ENABLED=true
# PAPYRUS_GATEWAY_HOST=127.0.0.1
# PAPYRUS_GATEWAY_PORT=3220
# PAPYRUS_GATEWAY_DEV_TOKEN=replace-with-local-dev-token
# PAPYRUS_GATEWAY_TLS_CERT=/etc/papyrus/gateway.pem
# PAPYRUS_GATEWAY_TLS_KEY=/etc/papyrus/gateway-key.pem
# PAPYRUS_GATEWAY_TLS_CA=/etc/papyrus/gateway-client-ca-bundle.pem

# Declarative config file (agents, license trust roots). See papyrus.example.yaml.
# PAPYRUS_CONFIG_FILE=/etc/papyrus/papyrus.yaml

# Inline overrides for the same settings (env wins over the YAML file).
# PAPYRUS_AGENTS_JSON={"opencode":{"command":"opencode","args":["acp"],"env":{"MODEL":"{model}","OPENAI_BASE_URL":"{baseUrl}","OPENAI_API_KEY":"{secret}"}}}
