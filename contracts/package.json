{
  "name": "@papyrus/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./plugins/index.ts",
      "import": "./dist/plugins/index.js"
    }
  },
  "scripts": {
